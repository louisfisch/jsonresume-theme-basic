{
    "name": "jsonresume-theme-basic",
    "version": "1.1.2",
    "description": "Theme for JSON Resume. It is very basic and can therefore be used both as a theme and boilerplate. The theme covers every single key of the JSON Resume schema.",
    "keywords": [
        "basic",
        "json",
        "jsonresume",
        "jsonresume-theme",
        "resume",
        "theme"
    ],
    "license": "MIT",
    "author": "Louis Fischer",
    "files": [
        "index.js",
        "resume.hbs"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/louisfisch/jsonresume-theme-basic"
    },
    "dependencies": {
        "handlebars": "^4.7.10",
        "html-minifier": "^4.0.0"
    },
    "devDependencies": {
        "resume-cli": "^3.7.3"
    },
    "overrides": {
        "puppeteer": "25.13.0"
    },
    "allowScripts": {
        "puppeteer@25.13.0": true,
        "core-js": false
    }
}
